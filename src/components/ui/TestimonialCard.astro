---
import type { Testimonial } from '../../types';
import { iconRegistry } from '../../lib/icons';
import { imageExists, slotToRealPath } from '../../lib/images';
import Card from './Card.astro';
import Badge from './Badge.astro';

interface Props extends Omit<Testimonial, 'id'> {
  id?: string;
  class?: string;
  /** Identitas mis. "testimonial.testimoni-1" — dipakai mencari avatar asli otomatis di
   * /images/testimonial/{key}.webp bila `avatar` belum diisi content file. */
  slot?: string;
}

const { name, role, quote, avatar, placeholder, id, slot, class: className } = Astro.props;

const UserIcon = iconRegistry['user-round'];
const avatarSrc = avatar || (slot ? slotToRealPath(slot) : undefined);
const hasAvatar = imageExists(avatarSrc);
---

<Card id={id} variant="default" class:list={['flex flex-col gap-4', className]}>
  {placeholder && (
    <Badge variant="gray" class="self-start">
      Placeholder
    </Badge>
  )}
  <p class="text-sm leading-relaxed text-gray-700">&ldquo;{quote}&rdquo;</p>
  <div class="mt-auto flex items-center gap-3">
    {hasAvatar ? (
      <img
        src={avatarSrc}
        alt={name}
        width="40"
        height="40"
        loading="lazy"
        class="h-10 w-10 rounded-full object-cover"
      />
    ) : (
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500"
        aria-hidden="true"
      >
        <UserIcon size={20} />
      </span>
    )}
    <div>
      <p class="text-sm font-semibold text-gray-900">{name}</p>
      <p class="text-xs text-gray-500">{role}</p>
    </div>
  </div>
</Card>
