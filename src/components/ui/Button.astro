---
type Variant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'accent' | 'light' | 'inverse';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  id?: string;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  type = 'button',
  disabled = false,
  id,
  class: className,
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-lg font-semibold transition duration-200 focus-ring disabled:pointer-events-none disabled:opacity-50';

// "outline" mengikuti spesifikasi Content Model (types/content.ts). Secara visual identik
// dengan "secondary" (border emerald) — DESIGN_SYSTEM.md hanya mendefinisikan 3 gaya tombol
// (Primary/Secondary/Ghost), jadi "outline" dipetakan ke gaya "Secondary" yang sudah ada,
// bukan gaya baru. "ghost" dipertahankan untuk kompatibilitas komponen Sprint 1 yang sudah ada.
//
// Warna emerald-600 diganti emerald-700 (Sprint 3.5 accessibility audit): emerald-600 vs putih
// hanya 3.65:1 (gagal WCAG AA 4.5:1, ditemukan sejak audit Sprint 1). emerald-700 = 5.36:1,
// dan tetap dalam palet resmi DESIGN_SYSTEM.md ("Primary: emerald-600, emerald-700, emerald-800").
const variants: Record<Variant, string> = {
  primary: 'bg-brand text-white hover:bg-brand-dark',
  secondary: 'border border-brand bg-white text-brand hover:bg-brand-soft',
  outline: 'border border-brand bg-white text-brand hover:bg-brand-soft',
  ghost: 'bg-transparent text-brand hover:bg-brand-soft',
  accent: 'bg-gold text-ink hover:bg-white',
  light: 'border border-white bg-white text-brand hover:bg-brand-soft',
  inverse: 'border border-white/50 bg-transparent text-white hover:bg-brand-dark',
};

const sizes: Record<Size, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const Tag = href ? 'a' : 'button';
const externalAttrs = href && external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

// <a> tidak punya native disabled state — pakai aria-disabled + tabindex -1 + kelas manual.
// <button> pakai atribut disabled native (otomatis memicu varian Tailwind `disabled:`).
const disabledAttrs = href
  ? { 'aria-disabled': disabled || undefined, tabindex: disabled ? -1 : undefined }
  : { disabled };
const disabledClass = href && disabled ? 'pointer-events-none opacity-50' : '';
---

<Tag
  id={id}
  href={href}
  type={href ? undefined : type}
  aria-label={ariaLabel}
  class:list={[base, variants[variant], sizes[size], disabledClass, className]}
  {...externalAttrs}
  {...disabledAttrs}
>
  <slot />
</Tag>
