---
import Card from './Card.astro';
import IconBox from './IconBox.astro';
import type { ProgramFeature } from '../../types/levels';
interface Props { feature: ProgramFeature; digital?: boolean }
const { feature, digital = false } = Astro.props;
---
<Card as="article" variant="bordered" class="h-full">
  <IconBox icon={feature.icon} color={digital ? 'digital' : 'brand'} />
  <h3 class="mt-5 text-xl font-bold text-ink">{feature.title}</h3>
  <p class="mt-3 text-base leading-relaxed text-muted">{feature.description}</p>
  {feature.items && <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm leading-relaxed text-muted">{feature.items.map(item => <li class="flex gap-2"><span aria-hidden="true" class="text-brand">•</span>{item}</li>)}</ul>}
</Card>
