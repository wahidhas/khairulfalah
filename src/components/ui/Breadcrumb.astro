---
import type { NavigationItem } from '../../types';

interface Props {
  items: NavigationItem[];
  id?: string;
  class?: string;
}

const { items, id, class: className } = Astro.props;
---

<nav id={id} aria-label="Breadcrumb" class:list={['text-sm text-gray-600', className]}>
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span class="font-medium text-gray-900" aria-current="page">
            {item.label}
          </span>
        ) : (
          <a href={item.href} class="rounded hover:text-emerald-700 focus-ring">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
