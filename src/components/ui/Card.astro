---
type Variant = 'default' | 'elevated' | 'bordered' | 'flat';
type Padding = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  padding?: Padding;
  as?: string;
  id?: string;
  class?: string;
}

const props = Astro.props;
const variant: Variant = props.variant ?? 'default';
const padding: Padding = props.padding ?? 'md';
const Tag = props.as ?? 'div';
const id = props.id;
const className = props.class;

const variants: Record<Variant, string> = {
  default: 'bg-white shadow-sm',
  elevated: 'bg-white shadow-md transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-lg',
  bordered: 'bg-white border border-gray-200',
  flat: 'bg-white',
};

const paddings: Record<Padding, string> = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const variantClass = variants[variant];
const paddingClass = paddings[padding];
---

<Tag id={id} class:list={['rounded-xl', paddingClass, variantClass, className]}>
  <slot />
</Tag>
