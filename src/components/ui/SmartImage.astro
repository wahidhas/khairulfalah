---
import { resolveImage } from '../../lib/images';

interface Props {
  src: string | undefined;
  alt: string;
  fallback: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  id?: string;
  class?: string;
}

const {
  src,
  alt,
  fallback,
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  id,
  class: className,
} = Astro.props;

const resolvedSrc = resolveImage(src, fallback);
---

<img
  id={id}
  src={resolvedSrc}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
/>
