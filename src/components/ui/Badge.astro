---
type Variant = 'primary' | 'secondary' | 'success' | 'warning' | 'gray';

interface Props {
  variant?: Variant;
  /**
   * Default true (eyebrow/label pendek). Set false untuk teks berupa kalimat penuh —
   * CONTENT_STRATEGY.md melarang "penggunaan huruf kapital berlebihan", dan kalimat
   * lengkap dalam ALL CAPS juga lebih sulit dibaca.
   */
  uppercase?: boolean;
  id?: string;
  class?: string;
}

const { variant = 'primary', uppercase = true, id, class: className } = Astro.props;

// Design System hanya mendefinisikan 3 warna (emerald/amber/gray — lihat DESIGN_SYSTEM.md
// Color System), jadi 5 varian semantik di bawah sengaja memetakan ke 3 treatment visual:
// primary = emerald solid (aksi/brand utama), secondary & success sama-sama emerald lembut
// (Design System tidak punya warna "success" terpisah — emerald paling dekat secara makna),
// warning = amber (warna accent/highlight yang sudah ada), gray = netral.
//
// primary pakai emerald-700, bukan emerald-600 (sama seperti Button, lihat Sprint 3.5):
// emerald-600 vs putih hanya 3.65:1 (gagal WCAG AA). emerald-700 = 5.36:1 dan tetap dalam
// palet resmi DESIGN_SYSTEM.md. Ditemukan di halaman Kurikulum (Badge "SENIN"/"SELASA").
const variants: Record<Variant, string> = {
  primary: 'bg-emerald-700 text-white',
  secondary: 'bg-emerald-100 text-emerald-700',
  success: 'bg-emerald-100 text-emerald-700',
  warning: 'bg-amber-100 text-amber-700',
  gray: 'bg-gray-100 text-gray-700',
};
---

<span
  id={id}
  class:list={[
    'inline-flex items-center rounded-lg px-3 py-1 text-xs font-semibold tracking-wide',
    uppercase ? 'uppercase' : 'normal-case',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
