---
import { iconRegistry } from '../../lib/icons';

interface Props {
  question: string;
  answer: string;
  id?: string;
  class?: string;
}

const { question, answer, id, class: className } = Astro.props;

const ChevronDown = iconRegistry['chevron-down'];
---

<details
  id={id}
  class:list={[
    'group rounded-xl border border-gray-100 bg-white open:shadow-sm',
    className,
  ]}
>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl p-6 font-semibold text-gray-900 focus-ring [&::-webkit-details-marker]:hidden"
  >
    <span>{question}</span>
    <ChevronDown
      size={20}
      class="shrink-0 text-emerald-700 transition-transform duration-200 group-open:rotate-180"
      aria-hidden="true"
    />
  </summary>
  <p class="px-6 pb-6 text-sm leading-relaxed text-gray-600">{answer}</p>
</details>
