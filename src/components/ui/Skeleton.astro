---
type Variant = 'card' | 'avatar' | 'text';

interface Props {
  variant?: Variant;
  lines?: number;
  id?: string;
  class?: string;
}

const { variant = 'text', lines = 3, id, class: className } = Astro.props;
---

{variant === 'card' && (
  <div id={id} class:list={['animate-pulse rounded-xl bg-white p-6 shadow-sm', className]} aria-hidden="true">
    <div class="h-10 w-10 rounded-lg bg-gray-200"></div>
    <div class="mt-4 h-4 w-3/4 rounded bg-gray-200"></div>
    <div class="mt-2 h-3 w-full rounded bg-gray-200"></div>
    <div class="mt-1 h-3 w-5/6 rounded bg-gray-200"></div>
  </div>
)}

{variant === 'avatar' && (
  <div id={id} class:list={['flex animate-pulse items-center gap-3', className]} aria-hidden="true">
    <div class="h-12 w-12 shrink-0 rounded-full bg-gray-200"></div>
    <div class="flex-1">
      <div class="h-3 w-24 rounded bg-gray-200"></div>
      <div class="mt-2 h-3 w-16 rounded bg-gray-200"></div>
    </div>
  </div>
)}

{variant === 'text' && (
  <div id={id} class:list={['flex animate-pulse flex-col gap-2', className]} aria-hidden="true">
    {Array.from({ length: lines }).map((_, index) => (
      <div class:list={['h-3 rounded bg-gray-200', index === lines - 1 ? 'w-2/3' : 'w-full']}></div>
    ))}
  </div>
)}
