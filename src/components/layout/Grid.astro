---
// Preset kolom ditulis sebagai string literal lengkap (bukan digabung dari angka) supaya
// JIT scanner Tailwind bisa mendeteksinya — class yang dirakit secara dinamis (mis.
// `grid-cols-${n}`) TIDAK akan ter-generate oleh Tailwind v4.
type Cols = '1' | '1-2' | '1-2-3' | '1-2-4' | '1-3' | '2-3' | '2-4';
type Gap = 'sm' | 'md' | 'lg';

interface Props {
  cols?: Cols;
  gap?: Gap;
  as?: string;
  id?: string;
  class?: string;
}

const props = Astro.props;
const cols: Cols = props.cols ?? '1-2-3';
const gap: Gap = props.gap ?? 'md';
const Tag = props.as ?? 'div';
const id = props.id;
const className = props.class;

const colsMap: Record<Cols, string> = {
  '1': 'grid-cols-1',
  '1-2': 'grid-cols-1 md:grid-cols-2',
  '1-2-3': 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  '1-2-4': 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4',
  '1-3': 'grid-cols-1 lg:grid-cols-3',
  '2-3': 'grid-cols-2 lg:grid-cols-3',
  '2-4': 'grid-cols-2 lg:grid-cols-4',
};

const gaps: Record<Gap, string> = {
  sm: 'gap-4',
  md: 'gap-6',
  lg: 'gap-8',
};
---

<Tag id={id} class:list={['grid', colsMap[cols], gaps[gap], className]}>
  <slot />
</Tag>
