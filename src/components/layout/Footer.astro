---
import Container from './Container.astro';
import FoundationLogo from '../ui/FoundationLogo.astro';
import { footerNavGroups, siteConfig, contactConfig } from '../../config';
import { isPlaceholder, whatsappHref, emailHref } from '../../lib/contact';
const year = new Date().getFullYear();
const wa = whatsappHref(contactConfig.whatsapp);
const email = emailHref(contactConfig.email);
---
<footer class="border-t border-line bg-white text-ink">
  <Container class="grid gap-10 py-16 md:grid-cols-2 xl:grid-cols-5">
    <div class="md:col-span-2 xl:col-span-5 lg:flex lg:items-start lg:justify-between lg:gap-12">
      <div><a href="/" aria-label="Yayasan Khairul Falah, Beranda" class="inline-flex items-center gap-4 rounded-lg text-2xl font-bold tracking-tight text-brand focus-ring"><FoundationLogo size={80} class="h-20 w-20" /><span>Yayasan Khairul Falah</span></a><p class="mt-3 text-lg font-semibold text-ink">{siteConfig.tagline}</p></div>
      <p class="mt-5 max-w-lg leading-relaxed text-muted lg:mt-0">{siteConfig.description}</p>
    </div>
    {footerNavGroups.map(group => <div><h2 class="text-base font-bold text-ink">{group.title}</h2><ul class="mt-4 flex flex-col gap-2">{group.items.map(item => <li><a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} class="inline-flex min-h-11 items-center gap-1 rounded text-sm text-muted hover:text-brand focus-ring">{item.label}{item.external && <><span aria-hidden="true">↗</span><span class="sr-only"> (tab baru)</span></>}</a></li>)}</ul></div>)}
    <div><h2 class="text-base font-bold text-ink">Kunjungi & Hubungi</h2><address class="mt-4 space-y-3 text-sm not-italic leading-relaxed text-muted"><p>{contactConfig.address}, {contactConfig.city}</p>{wa && <p><a href={wa} class="rounded underline underline-offset-4 focus-ring">WhatsApp: {contactConfig.whatsapp}</a></p>}{email && <p><a href={email} class="break-all rounded underline underline-offset-4 focus-ring">{contactConfig.email}</a></p>}{isPlaceholder(contactConfig.whatsapp) && isPlaceholder(contactConfig.email) && <p>Kontak resmi sedang dikonfirmasi.</p>}<p>{contactConfig.officeHours}</p><a href="/contact" class="inline-flex min-h-11 items-center rounded font-semibold text-brand underline underline-offset-4 focus-ring">Informasi Kontak</a></address></div>
  </Container>
  <div class="border-t border-line"><Container class="flex flex-col justify-between gap-3 py-6 text-sm text-muted sm:flex-row"><p>&copy; {year} {siteConfig.copyright}</p><p>Beriman. Beradab. Memberi dampak.</p></Container></div>
</footer>
