---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { SectionHeader, SmartImage } from '../ui';

interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  gallery: GalleryImage[];
}

const { gallery } = Astro.props;
---

{gallery.length > 0 && (
  <Section spacing="sm" class="bg-gray-50">
    <Container size="narrow">
      <SectionHeader badge="Dokumentasi" title="Galeri Foto" />
      <Grid cols="1-2-3" class="mt-8">
        {gallery.map((image) => (
          <figure class="overflow-hidden rounded-xl">
            <div class="aspect-square overflow-hidden rounded-xl bg-gray-200">
              <SmartImage
                src={image.src}
                alt={image.alt}
                slot="gallery"
                width={1200}
                height={1200}
                class="h-full w-full object-cover"
              />
            </div>
            {image.caption && (
              <figcaption class="mt-2 text-center text-sm text-gray-600">{image.caption}</figcaption>
            )}
          </figure>
        ))}
      </Grid>
    </Container>
  </Section>
)}
