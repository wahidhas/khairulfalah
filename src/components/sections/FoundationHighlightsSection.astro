---
import Container from '../layout/Container.astro';
import { sharedFoundation } from '../../content/levels';
import { academyHome } from '../../content/homepage/identity';
import { iconRegistry } from '../../lib/icons';

const tones = ['highlight-brand', 'highlight-rose', 'highlight-gold', 'highlight-blue'];
---

<section aria-labelledby="foundation-highlights" class="relative z-20 -mt-6">
  <Container>
    <h2 id="foundation-highlights" class="sr-only">{academyHome.highlightsLabel}</h2>
    <ul class="academy-highlights grid gap-6 rounded-2xl border border-line bg-white p-6 shadow-sm sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:p-8">
      {sharedFoundation.items.map((item, index) => {
        const Icon = iconRegistry[item.icon];
        return <li class="flex items-start gap-4 lg:border-r lg:border-line lg:px-5 lg:first:pl-0 lg:last:border-0 lg:last:pr-0">
          <span class:list={['flex h-12 w-12 shrink-0 items-center justify-center rounded-full', tones[index]]}><Icon size={25} aria-hidden="true" /></span>
          <div><h3 class="text-base font-bold leading-snug text-ink">{item.title}</h3><p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p></div>
        </li>;
      })}
    </ul>
  </Container>
</section>
