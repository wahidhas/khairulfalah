---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import CampaignVisual from '../ui/CampaignVisual.astro';
import { homeIdentity as content } from '../../content/homepage/identity';
---

<section class="academy-hero relative isolate overflow-hidden bg-cream">
  <CampaignVisual />
  <Container class="relative z-10 pointer-events-none">
    <div class="academy-hero-copy pointer-events-auto">
      <p class="text-sm font-bold tracking-wide text-brand">{content.eyebrow}</p>
      <h1 class="academy-hero-heading mt-5 text-ink">
        <span class="block">{content.headline[0]}</span>
        <span class="academy-emphasis">{content.headline[1]}</span>
      </h1>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-muted">{content.intro}</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <Button href="#jenjang">{content.primaryCta}</Button>
        <Button href="/kurikulum" variant="outline">Lihat Kurikulum</Button>
      </div>
    </div>
  </Container>
</section>
