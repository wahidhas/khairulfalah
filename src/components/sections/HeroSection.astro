---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import LevelIdentityCard from '../ui/LevelIdentityCard.astro';
import { homeIdentity as content } from '../../content/homepage/identity';
import { levels } from '../../content/levels';
---
<section class="bg-brand text-white">
  <Container class="pb-16 pt-12 text-center md:pb-20 md:pt-20">
    <p class="brand-eyebrow text-gold">{content.eyebrow}</p>
    <h1 class="hero-heading mx-auto mt-6 max-w-5xl"><span class="block text-gold">{content.headline[0]}</span><span class="block">{content.headline[1]}</span></h1>
    <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-white md:text-lg">{content.intro}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><Button href="#jenjang" variant="accent">{content.primaryCta}</Button><Button href="/ppdb" variant="inverse">{content.secondaryCta}</Button></div>
  </Container>
  <Container id="jenjang" class="pb-12 md:pb-16"><h2 class="mb-6 text-center text-base font-medium text-white">{content.levelsLabel}</h2><div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">{levels.map(level => <LevelIdentityCard level={level} />)}</div></Container>
</section>
