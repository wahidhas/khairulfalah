---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import { academyHome as content } from '../../content/homepage/identity';
import { getAllArticles } from '../../lib/articles';
import { imageExists } from '../../lib/images';
import { iconRegistry } from '../../lib/icons';

const articles = (await getAllArticles()).filter(article => article.data.category !== 'Achievements').slice(0, 3);
const Book = iconRegistry['book-open'];
const month = new Intl.DateTimeFormat('id-ID', { month: 'short', timeZone: 'Asia/Jakarta' });
---

<section class="bg-surface py-12 md:py-16">
  <Container class="grid gap-10 xl:grid-cols-[.9fr_1.1fr] xl:gap-12">
    <div class="grid items-center gap-6 sm:grid-cols-[.7fr_1fr] xl:grid-cols-[.65fr_1fr]">
      <div class="academy-about-visual rounded-2xl bg-sage p-6 text-brand">
        <Book size={64} aria-hidden="true" />
        <p class="mt-6 text-xl font-bold leading-snug">{content.aboutVisual}</p>
        <p class="mt-4 text-sm leading-relaxed">Al-Qur’an · Adab · Pengalaman nyata</p>
      </div>
      <div><p class="brand-eyebrow text-brand">{content.aboutEyebrow}</p><h2 class="mt-3 text-2xl font-bold leading-snug tracking-tight text-ink md:text-3xl">{content.aboutTitle}</h2><p class="mt-4 text-sm leading-relaxed text-muted">{content.aboutIntro}</p><Button href="/about" size="sm" class="mt-6">{content.aboutCta}</Button></div>
    </div>
    <div>
      <div class="mb-6 flex items-center justify-between gap-4"><h2 class="text-xl font-bold text-ink">{content.newsTitle}</h2><a href="/articles" class="inline-flex min-h-11 items-center rounded text-sm font-semibold text-brand underline-offset-4 hover:underline focus-ring">{content.newsCta}</a></div>
      <div class="grid gap-5 sm:grid-cols-3">
        {articles.map((article, index) => <article class="academy-news-card overflow-hidden rounded-xl border border-line bg-white">
          <div class:list={['relative flex aspect-[16/10] items-center justify-center overflow-hidden', index === 0 ? 'bg-sage text-brand' : index === 1 ? 'bg-rose-soft text-rose-ink' : 'bg-digital-soft text-digital']}>
            {imageExists(article.data.image.src) ? <img src={article.data.image.src} alt={article.data.image.alt} width="480" height="300" loading="lazy" class="h-full w-full object-cover" /> : <Book size={42} aria-hidden="true" />}
            <time datetime={article.data.publishDate.toISOString()} class="absolute left-0 top-0 flex flex-col rounded-br-xl bg-brand px-3 py-2 text-center text-white"><span class="text-xl font-bold leading-tight">{article.data.publishDate.getUTCDate()}</span><span class="text-sm uppercase">{month.format(article.data.publishDate)}</span></time>
          </div>
          <div class="p-4"><h3 class="text-base font-bold leading-snug text-ink"><a href={`/articles/${article.id}`} class="rounded hover:text-brand focus-ring">{article.data.title}</a></h3><p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">{article.data.description}</p></div>
        </article>)}
      </div>
    </div>
  </Container>
</section>
