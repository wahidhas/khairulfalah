---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { learningApproachHeader, learningApproach } from '../../content/curriculum';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...learningApproachHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {learningApproach.map((method) => (
        <Card variant="bordered" class="text-left">
          <IconBox icon={method.icon} color="emerald" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{method.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{method.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
