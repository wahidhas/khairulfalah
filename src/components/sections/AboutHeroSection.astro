---
import PageHeader from '../layout/PageHeader.astro';
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { SmartImage } from '../ui';
import { aboutHero } from '../../content/about';
---

<PageHeader
  title={aboutHero.title}
  description={aboutHero.description}
  breadcrumb={aboutHero.breadcrumb}
/>

<Section>
  <Container>
    <div class="overflow-hidden rounded-2xl bg-gray-200">
      <SmartImage
        src={aboutHero.image.src}
        alt={aboutHero.image.alt}
        slot="about.hero"
        width={1920}
        height={1080}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>
  </Container>
</Section>
