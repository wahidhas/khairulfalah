---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { whyChooseHeader, whyChoose } from '../../content/ppdb';
---

<Section>
  <Container>
    <SectionHeader {...whyChooseHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {whyChoose.map((reason) => (
        <Card variant="elevated" class="text-left">
          <IconBox icon={reason.icon} color="emerald" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{reason.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{reason.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
