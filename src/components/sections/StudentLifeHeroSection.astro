---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Button, SectionHeader, Breadcrumb } from '../ui';
import { studentLifeHero } from '../../content/student-life';
---

<Section class="bg-gray-50">
  <Container class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      {studentLifeHero.breadcrumb && (
        <div class="mb-4">
          <Breadcrumb items={studentLifeHero.breadcrumb} />
        </div>
      )}
      <SectionHeader
        as="h1"
        align="left"
        title={studentLifeHero.header.title}
        description={studentLifeHero.header.description}
      />
      <div class="mt-8 flex flex-wrap gap-4">
        <Button
          href={studentLifeHero.primaryCTA.href}
          variant={studentLifeHero.primaryCTA.variant}
          external={studentLifeHero.primaryCTA.external}
        >
          {studentLifeHero.primaryCTA.label}
        </Button>
        {studentLifeHero.secondaryCTA && (
          <Button
            href={studentLifeHero.secondaryCTA.href}
            variant={studentLifeHero.secondaryCTA.variant}
            external={studentLifeHero.secondaryCTA.external}
          >
            {studentLifeHero.secondaryCTA.label}
          </Button>
        )}
      </div>
    </div>

    <div class="flex aspect-4/3 items-center justify-center overflow-hidden rounded-2xl bg-gray-200">
      {studentLifeHero.image.src ? (
        <img
          src={studentLifeHero.image.src}
          alt={studentLifeHero.image.alt}
          class="h-full w-full object-cover"
          loading="eager"
        />
      ) : (
        <p class="px-6 text-center text-sm text-gray-700">{studentLifeHero.image.alt}</p>
      )}
    </div>
  </Container>
</Section>
