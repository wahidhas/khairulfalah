---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { contactInfoHeader, contactInfo } from '../../content/contact';
---

<Section id="informasi-kontak" class="bg-gray-50">
  <Container>
    <SectionHeader {...contactInfoHeader} />
    <Grid cols="1-2-4" class="mt-10">
      {contactInfo.map((channel) => (
        <Card variant="bordered" class="text-left">
          <IconBox icon={channel.icon} color="emerald" />
          <h3 class="mt-4 text-sm font-semibold text-gray-900">{channel.label}</h3>
          {channel.href ? (
            <a
              href={channel.href}
              class="mt-2 block rounded text-sm text-emerald-700 hover:underline focus-ring"
            >
              {channel.value}
            </a>
          ) : (
            <p class="mt-2 text-sm text-gray-600">{channel.value}</p>
          )}
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
