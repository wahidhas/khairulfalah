---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { valuesHeader, values } from '../../content/about';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...valuesHeader} />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {values.map((value) => (
        <Card variant="bordered" class="text-left">
          <IconBox icon={value.icon} color="emerald" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{value.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{value.description}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>
