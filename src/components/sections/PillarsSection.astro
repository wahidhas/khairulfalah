---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { pillarsHeader, pillars } from '../../content/transformation';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...pillarsHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {pillars.map((pillar) => (
        <Card variant="elevated" class="flex flex-col items-center text-center">
          <IconBox icon={pillar.icon} color="emerald" size="lg" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{pillar.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{pillar.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
