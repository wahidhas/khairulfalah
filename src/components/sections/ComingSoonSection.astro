---
import { Image } from 'astro:assets';
import { ArrowUpRight, CalendarDays, Clock3, Heart, Sparkles } from '@lucide/astro';
import FoundationLogo from '../ui/FoundationLogo.astro';
import teachersDay from '../../../public/images/articles/hari-guru-khairul-falah/cover.webp';
import { launch } from '../../content/launch';
---

<section class="launch-page relative isolate min-h-svh overflow-hidden bg-cream text-ink" data-launch-at={launch.opensAt} aria-labelledby="launch-title">
  <div class="launch-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-6 py-6 sm:px-10 lg:px-12 lg:py-8">
    <header class="flex items-center justify-between gap-4 border-b border-brand/15 pb-6">
      <div class="flex items-center gap-3">
        <FoundationLogo size={72} loading="eager" class="h-16 w-16 sm:h-18 sm:w-18" />
        <p class="leading-tight"><span class="block text-xs font-semibold uppercase tracking-widest text-muted">Yayasan</span><span class="mt-1 block text-lg font-bold sm:text-xl">Khairul Falah<span class="text-brand">.</span></span></p>
      </div>
      <span class="hidden rounded-full border border-brand/20 bg-white/60 px-4 py-2 text-xs font-semibold text-brand sm:block">Segera hadir</span>
    </header>

    <div class="grid items-center gap-10 py-12 lg:grid-cols-2 lg:gap-16 lg:py-16">
      <div>
        <p class="mb-5 flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand"><span class="h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true"></span> Segera hadir · Ruang baru untuk bertumbuh</p>
        <h1 id="launch-title" class="launch-heading font-bold tracking-tight">Website Resmi<br />Madrasah<br /><span class="text-brand">Khairul Falah<span class="text-gold">.</span></span></h1>
        <p class="mt-6 max-w-md text-base leading-relaxed text-muted">Satu ruang untuk mengenal madrasah, mengikuti kabar, dan menyaksikan karya generasi masa depan.</p>

        <div class="mt-8 border-l-4 border-gold pl-5">
          <p class="text-xl font-bold text-brand sm:text-2xl">Dibentuk, <span class="font-medium italic">bukan hanya diajar.</span></p>
          <p class="mt-2 text-sm text-muted">Satu yayasan. Dua keunggulan. Satu fondasi kebaikan.</p>
        </div>

        <p class="mt-9 text-xs font-semibold uppercase tracking-widest text-muted">Dibuka pada</p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
          <p class="flex items-center gap-2"><CalendarDays size={18} class="text-brand" aria-hidden="true" /><time datetime={launch.opensAt}>{launch.dateLabel}</time></p>
          <p class="flex items-center gap-2"><Clock3 size={18} class="text-brand" aria-hidden="true" />{launch.timeLabel}</p>
        </div>

        <div class="mt-6" data-launch-countdown>
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-muted">Hitung mundur pembukaan</p>
          <dl class="grid max-w-md grid-cols-4 gap-2 sm:gap-3" aria-label="Waktu menuju pembukaan" role="timer">
            {['Hari', 'Jam', 'Menit', 'Detik'].map((label, index) => (
              <div class="rounded-2xl border border-brand/15 bg-white/80 px-2 py-4 text-center">
                <dd class="text-3xl font-bold tabular-nums text-brand sm:text-4xl" data-countdown-unit={index}>—</dd>
                <dt class="mt-1 text-xs text-muted">{label}</dt>
              </div>
            ))}
          </dl>
        </div>
        <noscript><p class="mt-4 text-sm text-muted">Website dibuka pada 25 November 2026 pukul 10.00 WIB. Kunjungi kembali saat pembukaan.</p></noscript>
        <a href="/" class="mt-6 inline-flex min-h-12 items-center gap-3 rounded-full bg-brand px-6 py-3 text-sm font-bold text-white hover:bg-brand-dark focus-ring" data-launch-link hidden>Masuk ke website <ArrowUpRight size={18} aria-hidden="true" /></a>
      </div>

      <aside class="launch-tribute relative overflow-hidden rounded-3xl bg-brand text-white" aria-labelledby="teachers-day-title">
        <div class="relative p-7 pb-8 sm:p-9">
          <span class="absolute right-7 top-7 text-gold/70 sm:right-9 sm:top-9" aria-hidden="true"><Sparkles size={30} /></span>
          <p class="mb-7 text-xs font-semibold uppercase tracking-widest text-white/75">25 November · Hari Guru Nasional</p>
          <Heart size={28} class="mb-4 text-gold" aria-hidden="true" />
          <h2 id="teachers-day-title" class="text-3xl font-semibold leading-tight sm:text-4xl">Selamat<br /><span class="text-gold">Hari Guru.</span></h2>
          <p class="mt-5 max-w-sm text-sm leading-7 text-white/85">Terima kasih telah membimbing dengan hati, menanamkan adab, dan menyalakan keberanian untuk bermimpi.</p>
          <p class="mt-5 text-sm font-semibold text-gold">Untuk setiap ilmu dan teladan yang tak ternilai.</p>
        </div>
        <Image src={teachersDay} alt="Siswa belajar menjadi guru dengan pendampingan guru di Madrasah Khairul Falah" width={840} format="webp" loading="eager" class="aspect-video w-full object-cover" />
      </aside>
    </div>

    <footer class="flex flex-col gap-3 border-t border-brand/15 pt-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Yayasan Khairul Falah</p>
      <p class="flex flex-wrap gap-x-4 gap-y-2"><span>MI · Adab & Life Skills</span><span>MTs · Digital Creator</span></p>
    </footer>
  </div>
</section>

<style>
  .launch-heading { font-size: clamp(2.5rem, 4.5vw, 4.25rem); line-height: 1.1; }
  .launch-grid { background-image: radial-gradient(var(--color-brand) 1px, transparent 1px); background-size: 24px 24px; opacity: .045; mask-image: linear-gradient(to bottom, black, transparent 70%); }
  .launch-tribute { box-shadow: 0 24px 60px color-mix(in srgb, var(--color-brand) 14%, transparent); }
</style>

<script>
  const launchPage = document.querySelector<HTMLElement>('[data-launch-at]');
  if (launchPage) {
    const opensAt = Date.parse(launchPage.dataset.launchAt ?? '');
    const units = launchPage.querySelectorAll<HTMLElement>('[data-countdown-unit]');
    let interval: ReturnType<typeof setInterval> | undefined;
    function updateCountdown() {
      const remaining = Math.max(0, Math.ceil((opensAt - Date.now()) / 1000));
      const values = [Math.floor(remaining / 86400), Math.floor(remaining / 3600) % 24, Math.floor(remaining / 60) % 60, remaining % 60];
      units.forEach((unit, index) => { unit.textContent = String(values[index]).padStart(2, '0'); });
      if (remaining === 0) {
        launchPage?.querySelector<HTMLElement>('[data-launch-countdown]')?.setAttribute('hidden', '');
        launchPage?.querySelector<HTMLElement>('[data-launch-link]')?.removeAttribute('hidden');
        if (interval) clearInterval(interval);
      }
    }
    if (Number.isFinite(opensAt)) {
      updateCountdown();
      if (Date.now() < opensAt) interval = setInterval(updateCountdown, 1000);
    }
  }
</script>
