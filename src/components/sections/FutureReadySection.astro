---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { futureReadyHeader, futureReady } from '../../content/transformation';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...futureReadyHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {futureReady.map((skill) => (
        <Card variant="bordered" class="text-left">
          <IconBox icon={skill.icon} color={skill.color as 'emerald' | 'amber' | 'gray'} />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{skill.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{skill.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
