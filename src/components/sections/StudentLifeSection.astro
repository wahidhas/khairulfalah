---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Card, IconBox, SectionHeader, SmartImage } from '../ui';
import { studentLifeHeader, studentLife } from '../../content/homepage/student-life';
---

<Section>
  <Container>
    <SectionHeader {...studentLifeHeader} />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {studentLife.map((item) => (
        <Card variant="bordered" class="text-left">
          <div class="aspect-video overflow-hidden rounded-lg bg-gray-100">
            <SmartImage
              src={item.image?.src}
              alt={item.image?.alt ?? item.title}
              slot={item.imageSlot ?? 'gallery'}
              width={800}
              height={450}
              class="h-full w-full object-cover"
            />
          </div>
          <IconBox icon={item.icon} color="emerald" class="mt-4" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{item.description}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>
