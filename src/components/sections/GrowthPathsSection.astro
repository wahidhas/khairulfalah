---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { growthPaths as content } from '../../content/homepage/identity';
import IconBox from '../ui/IconBox.astro';
---
<Section class="bg-brand-soft">
  <Container><p class="brand-eyebrow text-brand">{content.badge}</p><div class="mt-4 grid gap-6 lg:grid-cols-2 lg:items-end"><h2 class="brand-heading max-w-xl text-ink">{content.title}</h2><p class="max-w-xl text-lg leading-relaxed text-muted">{content.description}</p></div>
    <ol class="mt-10 grid gap-6 md:grid-cols-2">{content.items.map((item, index) => <li class:list={['rounded-2xl border-t-4 bg-white p-6 md:p-8', index === 0 ? 'border-brand' : 'border-digital']}><IconBox icon={item.icon} /><p class="brand-eyebrow mt-6 text-brand">{item.label}</p><h3 class="mt-3 text-2xl font-bold tracking-tight text-ink">{item.title}</h3><p class="mt-4 leading-relaxed text-muted">{item.description}</p><a href={item.href} class="mt-6 inline-flex min-h-11 items-center rounded-lg font-semibold text-brand underline underline-offset-4 focus-ring">Kenali {item.label}</a></li>)}</ol>
  </Container>
</Section>
