---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Card, IconBox, Button, SectionHeader } from '../ui';
import {
  featuredProgramsHeader,
  featuredPrograms,
  featuredProgramsCta,
} from '../../content/homepage/featured-programs';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...featuredProgramsHeader} />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {featuredPrograms.map((program) => (
        <Card variant="elevated" class="text-left">
          <IconBox icon={program.icon} color="amber" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{program.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{program.description}</p>
        </Card>
      ))}
    </div>
    <div class="mt-10 flex justify-center">
      <Button href={featuredProgramsCta.href} variant={featuredProgramsCta.variant}>
        {featuredProgramsCta.label}
      </Button>
    </div>
  </Container>
</Section>
