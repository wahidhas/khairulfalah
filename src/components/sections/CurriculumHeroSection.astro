---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Button, SectionHeader, Breadcrumb, SmartImage } from '../ui';
import { curriculumHero } from '../../content/curriculum';
---

<Section class="bg-gray-50">
  <Container class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      {curriculumHero.breadcrumb && (
        <div class="mb-4">
          <Breadcrumb items={curriculumHero.breadcrumb} />
        </div>
      )}
      <SectionHeader
        as="h1"
        align="left"
        title={curriculumHero.header.title}
        description={curriculumHero.header.description}
      />
      <div class="mt-8 flex flex-wrap gap-4">
        <Button
          href={curriculumHero.primaryCTA.href}
          variant={curriculumHero.primaryCTA.variant}
          external={curriculumHero.primaryCTA.external}
        >
          {curriculumHero.primaryCTA.label}
        </Button>
        {curriculumHero.secondaryCTA && (
          <Button
            href={curriculumHero.secondaryCTA.href}
            variant={curriculumHero.secondaryCTA.variant}
            external={curriculumHero.secondaryCTA.external}
          >
            {curriculumHero.secondaryCTA.label}
          </Button>
        )}
      </div>
    </div>

    <div class="aspect-4/3 overflow-hidden rounded-2xl bg-gray-200">
      <SmartImage
        src={curriculumHero.image.src}
        alt={curriculumHero.image.alt}
        fallback="/images/placeholders/hero-placeholder.svg"
        width={1920}
        height={1440}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
  </Container>
</Section>
