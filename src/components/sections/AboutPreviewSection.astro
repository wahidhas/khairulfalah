---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Button, SectionHeader, SmartImage } from '../ui';
import { aboutPreview, aboutPreviewImage } from '../../content/homepage/about-preview';
---

<Section class="bg-gray-50">
  <Container class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      <SectionHeader align="left" {...aboutPreview.header} />
      <div class="mt-8 flex flex-wrap gap-4">
        <Button
          href={aboutPreview.primaryCTA.href}
          variant={aboutPreview.primaryCTA.variant}
          external={aboutPreview.primaryCTA.external}
        >
          {aboutPreview.primaryCTA.label}
        </Button>
        {aboutPreview.secondaryCTA && (
          <Button
            href={aboutPreview.secondaryCTA.href}
            variant={aboutPreview.secondaryCTA.variant}
            external={aboutPreview.secondaryCTA.external}
          >
            {aboutPreview.secondaryCTA.label}
          </Button>
        )}
      </div>
    </div>

    <div class="aspect-4/3 overflow-hidden rounded-2xl bg-gray-200">
      <SmartImage
        src={aboutPreviewImage.src}
        alt={aboutPreviewImage.alt}
        fallback="/images/placeholders/hero-placeholder.svg"
        width={1600}
        height={1200}
        class="h-full w-full object-cover"
      />
    </div>
  </Container>
</Section>
