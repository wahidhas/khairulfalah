---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Card, SectionHeader } from '../ui';
import { visionMissionHeader, visionMission } from '../../content/about';
---

<Section>
  <Container>
    <SectionHeader {...visionMissionHeader} />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <Card variant="elevated" class="text-left">
        <h3 class="text-lg font-semibold text-emerald-700">Visi</h3>
        <p class="mt-3 text-base text-gray-700">{visionMission.vision}</p>
      </Card>
      <Card variant="elevated" class="text-left">
        <h3 class="text-lg font-semibold text-emerald-700">Misi</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {visionMission.mission.map((point) => (
            <li class="flex gap-2 text-base text-gray-700">
              <span class="text-emerald-600" aria-hidden="true">•</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </Card>
    </div>
  </Container>
</Section>
