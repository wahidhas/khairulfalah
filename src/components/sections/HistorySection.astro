---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Card, SectionHeader } from '../ui';
import { historyHeader, history } from '../../content/about';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...historyHeader} />
    <ol class="mx-auto mt-10 flex max-w-2xl flex-col gap-6">
      {history.map((item) => (
        <li>
          <Card variant="bordered" class="text-left">
            <span class="text-xs font-semibold uppercase tracking-wide text-emerald-700">
              {item.year}
            </span>
            <h3 class="mt-1 text-base font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{item.description}</p>
          </Card>
        </li>
      ))}
    </ol>
  </Container>
</Section>
