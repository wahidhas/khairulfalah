---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { learningExperienceHeader, learningExperience } from '../../content/student-life';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...learningExperienceHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {learningExperience.map((item) => (
        <Card variant="elevated" class="text-left">
          <IconBox icon={item.icon} color="emerald" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{item.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
