---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Button, SectionHeader, Breadcrumb, SmartImage } from '../ui';
import { futureSkillsHero } from '../../content/future-skills';
---

<Section class="bg-gray-50">
  <Container class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      {futureSkillsHero.breadcrumb && (
        <div class="mb-4">
          <Breadcrumb items={futureSkillsHero.breadcrumb} />
        </div>
      )}
      <SectionHeader
        as="h1"
        align="left"
        title={futureSkillsHero.header.title}
        description={futureSkillsHero.header.description}
      />
      <div class="mt-8 flex flex-wrap gap-4">
        <Button
          href={futureSkillsHero.primaryCTA.href}
          variant={futureSkillsHero.primaryCTA.variant}
          external={futureSkillsHero.primaryCTA.external}
        >
          {futureSkillsHero.primaryCTA.label}
        </Button>
        {futureSkillsHero.secondaryCTA && (
          <Button
            href={futureSkillsHero.secondaryCTA.href}
            variant={futureSkillsHero.secondaryCTA.variant}
            external={futureSkillsHero.secondaryCTA.external}
          >
            {futureSkillsHero.secondaryCTA.label}
          </Button>
        )}
      </div>
    </div>

    <div class="aspect-4/3 overflow-hidden rounded-2xl bg-gray-200">
      <SmartImage
        src={futureSkillsHero.image.src}
        alt={futureSkillsHero.image.alt}
        slot="future-skills.hero"
        width={1920}
        height={1440}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
  </Container>
</Section>
