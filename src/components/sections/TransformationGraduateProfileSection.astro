---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { transformationGraduateProfileHeader, transformationGraduateProfile } from '../../content/transformation';
---

<Section>
  <Container>
    <SectionHeader {...transformationGraduateProfileHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {transformationGraduateProfile.map((trait) => (
        <Card variant="bordered" class="text-left">
          <IconBox icon={trait.icon} color="amber" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{trait.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{trait.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
