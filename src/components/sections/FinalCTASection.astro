---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { Button, SectionHeader } from '../ui';
import type { CTASection } from '../../types';
import { finalCta as homepageFinalCta } from '../../content/homepage/final-cta';

interface Props {
  content?: CTASection;
}

const finalCta = Astro.props.content ?? homepageFinalCta;
---

<Section>
  <Container>
    <div class="rounded-2xl bg-emerald-700 px-6 py-12 md:py-16">
      <SectionHeader
        badge={finalCta.header.badge}
        title={finalCta.header.title}
        subtitle={finalCta.header.subtitle}
        description={finalCta.header.description}
        invert
      />
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={finalCta.primaryCTA.href}
          variant={finalCta.primaryCTA.variant}
          external={finalCta.primaryCTA.external}
        >
          {finalCta.primaryCTA.label}
        </Button>
        {finalCta.secondaryCTA && (
          <Button
            href={finalCta.secondaryCTA.href}
            variant={finalCta.secondaryCTA.variant}
            external={finalCta.secondaryCTA.external}
          >
            {finalCta.secondaryCTA.label}
          </Button>
        )}
      </div>
    </div>
  </Container>
</Section>
