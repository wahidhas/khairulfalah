---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { newDirectionHeader, newDirection } from '../../content/transformation';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...newDirectionHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {newDirection.map((area) => (
        <Card variant="bordered" class="text-left">
          <IconBox icon={area.icon} color="amber" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{area.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{area.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
