---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import IconBox from '../ui/IconBox.astro';
import { growthPortal as content } from '../../content/levels/mi';
---
<Section><Container class="grid items-center gap-12 lg:grid-cols-2">
  <div><p class="brand-eyebrow text-brand">{content.badge}</p><h2 class="brand-heading mt-4 text-ink">{content.title}</h2><p class="mt-6 text-lg leading-relaxed text-muted">{content.description}</p><p class="mt-6 inline-flex rounded-lg border border-line bg-cream px-4 py-3 text-sm font-semibold text-brand">{content.label}</p></div>
  <figure aria-label={content.label} class="mx-auto w-full max-w-sm rounded-2xl border-8 border-ink bg-white p-5 shadow-lg md:p-6">
    <div aria-hidden="true" class="mx-auto mb-8 h-1 w-16 rounded bg-line"></div>
    <p class="text-lg font-bold text-brand">{content.appName}</p><p class="mt-1 text-sm text-muted">{content.appSubtitle}</p>
    <div class="mt-6 rounded-xl bg-brand p-5 text-white"><p class="text-sm text-gold">{content.period}</p><p class="mt-2 text-xl font-semibold">{content.greeting}</p><p class="mt-3 text-sm leading-relaxed">{content.note}</p></div>
    <ul class="mt-4 divide-y divide-line">{content.items.map(item => <li class="flex items-center gap-3 py-4"><IconBox icon={item.icon} color="brand" /><div class="min-w-0"><p class="text-sm font-semibold text-ink">{item.name}</p><p class="mt-1 text-sm text-muted">{item.status}</p></div></li>)}</ul>
    <figcaption class="border-t border-line pt-4 text-sm leading-relaxed text-muted">{content.label}</figcaption>
  </figure>
</Container></Section>
