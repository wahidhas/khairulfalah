---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { SectionHeader, SmartImage } from '../ui';
import { galleryHeader, gallery } from '../../content/student-life';
---

<Section>
  <Container>
    <SectionHeader {...galleryHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {gallery.map((image) => (
        <div class="aspect-square overflow-hidden rounded-xl bg-gray-200">
          <SmartImage
            src={image.src}
            alt={image.alt}
            slot={image.slot}
            width={1200}
            height={1200}
            class="h-full w-full object-cover"
          />
        </div>
      ))}
    </Grid>
  </Container>
</Section>
