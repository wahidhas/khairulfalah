---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { learningDomainsHeader, learningDomains } from '../../content/curriculum';
---

<Section id="kflf">
  <Container>
    <SectionHeader {...learningDomainsHeader} />
    <Grid cols="1-2-3" class="mt-10">
      {learningDomains.map((domain) => (
        <Card variant="elevated" class="text-left">
          <IconBox icon={domain.icon} color={domain.color as 'emerald' | 'amber' | 'gray'} />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{domain.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{domain.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
