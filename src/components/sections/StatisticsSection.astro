---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { StatisticCard, SectionHeader } from '../ui';
import { statisticsHeader, statistics } from '../../content/homepage/statistics';
---

<Section class="bg-gray-50">
  <Container>
    <SectionHeader {...statisticsHeader} />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {statistics.map((stat) => (
        <StatisticCard label={stat.label} value={stat.value} suffix={stat.suffix} />
      ))}
    </div>
  </Container>
</Section>
