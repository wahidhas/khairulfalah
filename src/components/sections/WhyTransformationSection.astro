---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import { Card, IconBox, SectionHeader } from '../ui';
import { whyTransformationHeader, whyTransformation } from '../../content/transformation';
---

<Section>
  <Container>
    <SectionHeader {...whyTransformationHeader} />
    <Grid cols="1-2-4" class="mt-10">
      {whyTransformation.map((point) => (
        <Card variant="elevated" class="text-left">
          <IconBox icon={point.icon} color="emerald" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">{point.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{point.description}</p>
        </Card>
      ))}
    </Grid>
  </Container>
</Section>
