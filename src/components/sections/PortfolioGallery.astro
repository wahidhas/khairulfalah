---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import { portfolio as content } from '../../content/levels/mts';
import { iconRegistry } from '../../lib/icons';
const Layers = iconRegistry.layers;
---
<Section class="bg-digital-soft"><Container>
  <div class="max-w-2xl"><p class="brand-eyebrow text-digital">{content.badge}</p><h2 class="brand-heading mt-4 text-ink">{content.title}</h2><p class="mt-5 leading-relaxed text-muted">{content.description}</p></div>
  <div class="mt-10 rounded-2xl border border-line bg-white px-6 py-12 text-center md:p-12"><Layers size={40} class="mx-auto text-digital" aria-hidden="true" /><h3 class="mt-6 text-2xl font-bold text-ink">{content.emptyTitle}</h3><p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">{content.emptyDescription}</p><ul class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-3">{content.categories.map(item => <li class="rounded-lg bg-digital-soft px-4 py-3 text-sm font-medium text-digital">{item}</li>)}</ul></div>
</Container></Section>
