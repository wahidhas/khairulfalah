---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SharedFoundationSection from '../components/sections/SharedFoundationSection.astro';
import GrowthPathsSection from '../components/sections/GrowthPathsSection.astro';
import KFLFPreviewSection from '../components/sections/KFLFPreviewSection.astro';
import StudentLifeSection from '../components/sections/StudentLifeSection.astro';
import AdmissionBanner from '../components/sections/AdmissionBanner.astro';
import { homeIdentity } from '../content/homepage/identity';
import { buildOrganizationSchema, buildWebsiteSchema } from '../lib/seo';
const organizationSchema = buildOrganizationSchema(Astro.site);
const websiteSchema = buildWebsiteSchema(Astro.site);
---
<MainLayout title={homeIdentity.title} description={homeIdentity.description}>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
  <HeroSection /><SharedFoundationSection /><GrowthPathsSection /><KFLFPreviewSection /><StudentLifeSection /><AdmissionBanner />
</MainLayout>
