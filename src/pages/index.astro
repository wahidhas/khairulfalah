---
import MainLayout from '../layouts/MainLayout.astro';
import {
  HeroSection,
  ValuePropositionSection,
  AboutPreviewSection,
  FeaturedProgramsSection,
  KFLFPreviewSection,
  FutureSkillsSection,
  StudentLifeSection,
  StatisticsSection,
  TestimonialsSection,
  FAQSection,
  FinalCTASection,
} from '../components/sections';
import { siteConfig } from '../config';
import { faq } from '../content/homepage/faq';
import { buildOrganizationSchema, buildWebsiteSchema, buildFAQSchema } from '../lib/seo';

const organizationSchema = buildOrganizationSchema(Astro.site);
const websiteSchema = buildWebsiteSchema(Astro.site);
const faqSchema = buildFAQSchema(faq);
---

<MainLayout title={siteConfig.siteName}>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <HeroSection />
  <ValuePropositionSection />
  <AboutPreviewSection />
  <FeaturedProgramsSection />
  <KFLFPreviewSection />
  <FutureSkillsSection />
  <StudentLifeSection />
  <StatisticsSection />
  <TestimonialsSection />
  <FAQSection />
  <FinalCTASection />
</MainLayout>
