# Salin file ini menjadi .env untuk pengembangan lokal, atau isi sebagai Environment
# Variables di dashboard hosting (Vercel) untuk produksi. Lihat DEPLOYMENT.md dan
# ANALYTICS_SETUP.md untuk detail masing-masing.
#
# Prefix PUBLIC_ wajib (konvensi Astro/Vite) agar nilainya bisa diakses di sisi client.
# Jangan pernah commit file .env berisi ID/nilai asli ke Git.

# URL produksi situs — dipakai astro.config.mjs sebagai `site` (canonical URL, sitemap, dsb).
PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). Kosongkan untuk menonaktifkan GA4.
PUBLIC_GA_ID=

# Microsoft Clarity Project ID. Kosongkan untuk menonaktifkan Clarity.
PUBLIC_CLARITY_ID=

# Email kontak resmi madrasah — sumber untuk src/config/contact.ts.
PUBLIC_CONTACT_EMAIL=

# Nomor WhatsApp resmi (format internasional tanpa +, mis. 6281234567890).
PUBLIC_WHATSAPP_NUMBER=
